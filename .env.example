# 문체부 문화데이터 오픈API (KCISA 한국문화정보원) 키
# 실제 키는 .env 에 넣고 커밋하지 않는다. (이 파일만 추적)
#
# 예술경영지원센터 KOPIS-공연시설별상세정보 — 전국 공연시설 venue 인덱스
#   https://api.kcisa.kr/openapi/service/rest/meta16/getkopis04
KCISA_KOPIS_FACILITY_KEY=your-kopis-facility-service-key

# (기존) 법제처 법령 API 키 (korean-law-mcp)
# LAW_OC=your-law-oc

# KOPIS 공연예술통합전산망 Open API — 공연/축제 catalog
KOPIS_SERVICE_KEY=your-kopis-service-key

# 식품안전나라 Open API — 회수.판매중지, 식중독 현황, 식품접객업/HACCP
FOOD_SAFETY_API_KEY=your-food-safety-service-key

# 공공데이터포털 — 한국관광공사 국문 관광정보 서비스_GW
TOUR_API_SERVICE_KEY=your-tour-api-service-key

# 공공데이터포털 — 국립중앙의료원 응급의료기관/AED 정보 조회 서비스
NEMC_SERVICE_KEY=your-nemc-service-key

# 서울 열린데이터광장 Open API — 실시간 도시데이터/인구/문화행사
SEOUL_OPENAPI_KEY=your-seoul-openapi-key

# 기상청 API Hub — 단기/초단기/중기예보, 특보, 영향예보, AWS, 레이더, 낙뢰, 생활·보건기상지수
KMA_APIHUB_KEY=your-kma-apihub-key

# 국가교통정보센터 ITS Open API — 교통소통/돌발/CCTV/VMS
# 2026-05-30 기준 신청 완료, 키 발급 대기
ITS_OPENAPI_KEY=your-its-openapi-key

# 공공데이터포털 — 한국환경공단 에어코리아 대기오염정보 API
AIRKOREA_SERVICE_KEY=your-airkorea-service-key

# 행정안전부 재난안전데이터 공유플랫폼 — 긴급재난문자 live adapter
# 2026-05-30 기준 행정안전부_긴급재난문자 신청 완료, 키 발급 대기
SAFETY_DATA_API_KEY=your-safety-data-service-key
